#!/bin/bash
#PBS -N rla_tests
#PBS -P personal-abhipray
#PBS -q normal
#PBS -l select=1:ncpus=2:ngpus=1:mem=8gb
#PBS -l walltime=00:30:00
#PBS -o /home/users/ntu/abhipray/tabmpp/logs/rla_tests.log
#PBS -e /home/users/ntu/abhipray/tabmpp/logs/rla_tests.err

set -eo pipefail

echo "== RLA tests =="
echo "job: $PBS_JOBID  host: $(hostname)"
nvidia-smi || true

cd "$HOME/tabmpp/tabm"
module load python/3.11.5-gcc12 cuda/11.8.0
# shellcheck disable=SC1090
source "$HOME/tabmpp/venv/bin/activate"

cd paper
export PYTHONPATH="$PWD:$PYTHONPATH"

python -m pytest tests/test_rla.py -v
echo "== tests done =="
