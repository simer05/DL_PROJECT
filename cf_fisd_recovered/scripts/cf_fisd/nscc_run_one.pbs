#!/bin/bash
#PBS -N cf_fisd_run
#PBS -P personal-simerjit
#PBS -q normal
#PBS -l select=1:ncpus=4:ngpus=1:mem=32gb
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -o /home/users/ntu/simerjit/scratch/tabm_proj/logs/cf_fisd/

set -euo pipefail

: "${CONFIG_TOML:?CONFIG_TOML must be set}"
: "${PAPER_DIR:=/home/users/ntu/simerjit/scratch/tabm_proj/tabm_fork/paper}"
: "${VENV:=/home/users/ntu/simerjit/scratch/tabm_proj/cf_fisd_venv}"

mkdir -p /home/users/ntu/simerjit/scratch/tabm_proj/logs/cf_fisd

module purge
module load python/3.10.9
source "$VENV/bin/activate"

cd "$PAPER_DIR"

OUT_DIR="${CONFIG_TOML%.toml}"
python -m bin.model "$CONFIG_TOML"
test -d "$OUT_DIR" && cp -f "$PAPER_DIR/.cf_fisd_state.json" "$OUT_DIR/cf_fisd_state.json" 2>/dev/null || true
